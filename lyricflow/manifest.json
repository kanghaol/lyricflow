{
  "manifest_version": 3,
  "name": "LyricFlow",
  "version": "1.0.0",
  "description": "Cross-tab synchronized Spotify lyrics overlay.",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["*://open.spotify.com/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://open.spotify.com/*"],
      "js": ["src/content/spotify.ts"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/overlay.tsx"]
    }
  ]
}